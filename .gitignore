# ============================================================
# APIGuard .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# ---------- Testing / tooling caches ----------
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---------- Runtime data (recreated automatically) ----------
# Scanner database (holds scan history; recreated with demo targets on start)
backend/apiguard.db
backend/apiguard.db-wal
backend/apiguard.db-shm
# VAmPI benchmark databases (recreated by third_party/run_vampi.py)
third_party/VAmPI/database/*.db
# Logs from scripts/run_all.sh
logs/
*.log
# Generated scan reports (keep the folder itself)
reports/*
!reports/.gitkeep

# ---------- Frontend / Node ----------
frontend/node_modules/
frontend/.vite/
# NOTE: frontend/dist/ is intentionally COMMITTED - the backend serves this
# pre-built dashboard, so the tool runs without Node.js.

# ---------- Secrets (none are needed - never commit any) ----------
.env
.env.*
*.pem
*.key

# ---------- OS / editor files ----------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
